# ───────────── Zevra environment (copy to .env) ─────────────
# Public URLs
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5174
PUBLIC_CORE_API_URL=            # e.g. http://localhost:8082 — empty keeps the web app on pilot demo data
PUBLIC_DEMO_MODE=true           # false in production: no demo fallbacks when services are unreachable

# Service-to-service
AUTH_API_URL=http://localhost:8081
CORE_API_URL=http://localhost:8082
WORKER_URL=http://localhost:8090
INTERNAL_API_SECRET=change-me-internal-secret
WORKER_SHARED_SECRET=change-me-worker-secret
MAIL_INBOUND_SECRET=change-me-inbound-secret

# Database (PostgreSQL 17) / Redis 7
DATABASE_URL=postgres://zevra:zevra@localhost:5432/zevra?sslmode=disable
REDIS_URL=redis://localhost:6379/0
STORE=postgres                  # or "memory" for a throwaway local auth service

# Sessions
COOKIE_DOMAIN=                  # .zevra.io in production (shared by zevra.io and app.zevra.io)
COOKIE_SECURE=true

# Hidden PGP admin gate — NEVER commit real values
ADMIN_GATE_PATH=/_v/change-me
ADMIN_GATE_SECRET=change-me-gate-secret
ADMIN_GATE_PASSPHRASE_SHA256=   # sha256 hex of the stealth-trigger passphrase
VAULT_DOMAIN=zevra.io
ADMIN_DEV_KEY_FILE=             # dev only, STORE=memory: preload one admin public key (.asc)

# OIDC providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ENABLE_PROTON_OIDC=false        # stub adapter; Proton has no public third-party OIDC IdP today

# WebAuthn (passkeys / Proton Pass)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174

# Mail
SMTP_ADDR=                      # empty → links are written to the auth-api log (dev)
SMTP_FROM=no-reply@zevra.io
SMTP_USER=
SMTP_PASS=

# Typst
TYPST_BIN=typst
TYPST_TEMPLATES=templates/typst
